# Copy this file to .env and fill in your Firebase values.
# Find these in: Firebase Console → Project Settings → Your apps → SDK setup
# NEVER commit .env to git. It's already in .gitignore by default in Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging → Web Push certificates → "Key pair" (generate if empty)
VITE_FIREBASE_VAPID_KEY=
