// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
// Or paste directly in: Firebase Console → Firestore → Rules tab

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own logs
    match /users/{userId}/logs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone signed in can read announcements.
    // Writing is blocked from the client — use Firebase Console to post.
    match /announcements/{docId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Friend System ─────────────────────────────────────

    // Profile: each user reads/writes their own
    match /users/{userId}/profile/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Friend codes: anyone authenticated can look one up;
    // only the owner can create/delete their own code entry.
    // Use request.resource for create (resource doesn't exist yet),
    // and resource for delete/update (document already exists).
    match /friend_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Friend list: owner reads; owner OR the friend can create/delete
    // (bidirectional remove requires the other user to delete from this list too)
    match /users/{userId}/friends/{friendUid} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendUid);
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendUid);
    }

    // Incoming friend requests: receiver reads;
    // sender (whose uid == requestId) can create or cancel their own request;
    // receiver can delete (accept/decline).
    match /users/{userId}/friend_requests/{requestId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == requestId;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == requestId);
    }

    // Sent friend requests: sender reads/writes;
    // recipient (whose uid == requestId) can delete on accept/decline.
    match /users/{userId}/sent_requests/{requestId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == requestId);
    }

    // Mushroom invitations: receiver reads/declines;
    // host (whose uid == request.resource.data.fromUid) can create (invite).
    match /users/{userId}/mushroom_invites/{docId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Shared mushroom doc (mutable collaborative data)
    // Any authenticated user can read/create/update — participants edit together.
    // Nobody can delete (users only delete their own local copy).
    match /mushrooms/{mushroomId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Roster (shared participant tracker — only host + member names)
    // Any authenticated user can read rosters.
    // Host creates it (auth.uid == resource.data.hostUid).
    // Any participant can update (join) — the update sets members.{theirUid}.
    match /roster/{rosterId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
